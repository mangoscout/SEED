import numpy as np
import cv2
import os
import time

CALIB_FILE = "camera_calib_once.npz"
CAM_INDEX = 0
MARKER_LENGTH_M = 0.1016
ARUCO_DICT = cv2.aruco.DICT_6X6_250

# Only run heavy vision logic every 3rd frame
PROCESS_EVERY_N_FRAMES = 3

#HEADLESS = os.environ.get("DISPLAY") is None

# ---------------- I2C SETUP FOR ARDUINO ----------------
ARDUINO_I2C_ADDR = 0x08

# Send to Arduino at controlled rate to prevent camera lag
ARDUINO_SEND_INTERVAL = 0.10
I2C_ERROR_PRINT_INTERVAL = 2.0

try:
    import smbus2
    arduino_bus = smbus2.SMBus(1)
    arduino_available = True
    print("Arduino I2C bus opened.")
except Exception as e:
    arduino_bus = None
    arduino_available = False
    print("Arduino I2C bus not available:", e)
# -------------------------------------------------------

if not os.path.exists(CALIB_FILE):
    raise FileNotFoundError(f"{CALIB_FILE} not found. Run calibrate_once.py first.")

data = np.load(CALIB_FILE)
K = data["K"]
dist = data["dist"]

# Camera setup
cap = cv2.VideoCapture(CAM_INDEX)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

if not cap.isOpened():
    raise RuntimeError("Could not open camera.")

for _ in range(15):
    cap.read()

ok, frame = cap.read()
if not ok:
    raise RuntimeError("Could not read from camera.")

h, w = frame.shape[:2]

# Undistortion
newK, roi = cv2.getOptimalNewCameraMatrix(
    K, dist, (w, h), alpha=0.0, newImgSize=(w, h)
)

map1, map2 = cv2.initUndistortRectifyMap(
    K, dist, None, newK, (w, h), cv2.CV_16SC2
)

x, y, rw, rh = roi

croppedK = newK.copy()
croppedK[0, 2] -= x
croppedK[1, 2] -= y

# ArUco setup
aruco_dict = cv2.aruco.getPredefinedDictionary(ARUCO_DICT)
detector_params = cv2.aruco.DetectorParameters()
detector_params.cornerRefinementMethod = cv2.aruco.CORNER_REFINE_NONE
detector = cv2.aruco.ArucoDetector(aruco_dict, detector_params)

L = MARKER_LENGTH_M
obj_points = np.array([
    [-L / 2,  L / 2, 0.0],
    [ L / 2,  L / 2, 0.0],
    [ L / 2, -L / 2, 0.0],
    [-L / 2, -L / 2, 0.0]
], dtype=np.float32)

last_sent_packet = ""
last_arduino_send_time = 0
last_i2c_error_time = 0

# Saved results for skipped frames
frame_count = 0
last_x_angle_deg = None
last_distance_m = None
last_color_code = -1
last_color_name = "NONE"
last_turn_cmd = 0
last_color_seen_frames = 0
last_marker_for_draw = None
last_ids = None
last_color_roi = None

# Hold last good color result briefly so detection does not flicker
COLOR_HOLD_FRAMES = 5


def get_largest_blob(mask, bgr_img, box_color, min_area=180):
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    if len(contours) == 0:
        return 0

    largest = max(contours, key=cv2.contourArea)
    area = cv2.contourArea(largest)

    if area < min_area:
        return 0

    x_box, y_box, w_box, h_box = cv2.boundingRect(largest)
    cx = x_box + w_box // 2
    cy = y_box + h_box // 2

    cv2.rectangle(bgr_img, (x_box, y_box), (x_box + w_box, y_box + h_box), box_color, 2)
    cv2.circle(bgr_img, (cx, cy), 5, box_color, -1)

    return area


def detect_arrow_color(bgr_img):
    hsv = cv2.cvtColor(bgr_img, cv2.COLOR_BGR2HSV)
    hsv = cv2.GaussianBlur(hsv, (5, 5), 0)

    # RED masks
    lower_red1 = np.array([0, 120, 70])
    upper_red1 = np.array([10, 255, 255])

    lower_red2 = np.array([170, 120, 70])
    upper_red2 = np.array([180, 255, 255])

    # GREEN mask
    lower_green = np.array([35, 60, 60])
    upper_green = np.array([95, 255, 255])

    red_mask1 = cv2.inRange(hsv, lower_red1, upper_red1)
    red_mask2 = cv2.inRange(hsv, lower_red2, upper_red2)
    red_mask = cv2.bitwise_or(red_mask1, red_mask2)

    green_mask = cv2.inRange(hsv, lower_green, upper_green)

    kernel_open = np.ones((3, 3), np.uint8)
    kernel_close = np.ones((5, 5), np.uint8)
    kernel_erode = np.ones((3, 3), np.uint8)

    # Clean red mask
    red_mask = cv2.morphologyEx(red_mask, cv2.MORPH_OPEN, kernel_open)
    red_mask = cv2.morphologyEx(red_mask, cv2.MORPH_CLOSE, kernel_close)

    # Clean green mask
    green_mask = cv2.erode(green_mask, kernel_erode, iterations=2)
    green_mask = cv2.dilate(green_mask, kernel_erode, iterations=2)
    green_mask = cv2.morphologyEx(green_mask, cv2.MORPH_CLOSE, kernel_close)

    red_area = get_largest_blob(red_mask, bgr_img, (0, 0, 255), min_area=180)
    green_area = get_largest_blob(green_mask, bgr_img, (0, 255, 0), min_area=180)

    color_code = -1
    color_name = "NONE"
    turn_cmd = 0

    # GREEN = LEFT = -90
    # RED   = RIGHT = 90
    if green_area > 0 and green_area >= red_area:
        color_code = 1
        color_name = "GREEN"
        turn_cmd = -90
    elif red_area > 0:
        color_code = 0
        color_name = "RED"
        turn_cmd = 90

    return color_code, color_name, turn_cmd


def send_packet_i2c(packet_str):
    global arduino_bus, arduino_available, last_i2c_error_time

    if not arduino_available or arduino_bus is None:
        return

    try:
        byte_data = [ord(c) for c in packet_str]

        # SMBus block writes max out at 32 bytes.
        if len(byte_data) > 32:
            byte_data = byte_data[:32]

        arduino_bus.write_i2c_block_data(ARDUINO_I2C_ADDR, 0, byte_data)

    except Exception as e:
        current_time = time.time()

        if current_time - last_i2c_error_time >= I2C_ERROR_PRINT_INTERVAL:
            print("I2C send error:", e)
            last_i2c_error_time = current_time


while True:
    ok, frame = cap.read()
    if not ok:
        continue

    undist = cv2.remap(frame, map1, map2, interpolation=cv2.INTER_LINEAR)
    undist_cropped = undist[y:y + rh, x:x + rw].copy()

    frame_count += 1

    # Use last known values on skipped frames
    x_angle_deg = last_x_angle_deg
    distance_m = last_distance_m
    color_code = last_color_code
    color_name = last_color_name
    turn_cmd = last_turn_cmd
    marker_for_draw = last_marker_for_draw
    ids_to_draw = last_ids
    color_roi = last_color_roi

    # Only run heavier detection every 3rd frame
    if frame_count % PROCESS_EVERY_N_FRAMES == 0:
        x_angle_deg = None
        distance_m = None
        color_code = -1
        color_name = "NONE"
        turn_cmd = 0
        marker_for_draw = None
        ids_to_draw = None
        color_roi = None

        corners, ids, _ = detector.detectMarkers(undist_cropped)

        if ids is not None:
            for i, marker in enumerate(corners):
                img_points = marker.reshape(4, 2).astype(np.float32)

                success, rvec, tvec = cv2.solvePnP(
                    obj_points,
                    img_points,
                    croppedK,
                    None,
                    flags=cv2.SOLVEPNP_IPPE_SQUARE
                )

                if success:
                    t = tvec.reshape(3)

                    x_angle_deg = float(np.degrees(np.arctan2(t[0], t[2])))
                    distance_m = float(np.linalg.norm(t))

                    xmin = int(np.min(img_points[:, 0]))
                    xmax = int(np.max(img_points[:, 0]))
                    ymin = int(np.min(img_points[:, 1]))
                    ymax = int(np.max(img_points[:, 1]))

                    pad = 100

                    xmin = max(0, xmin - pad)
                    xmax = min(rw, xmax + pad)
                    ymin = max(0, ymin - pad)
                    ymax = min(rh, ymax + pad)

                    roi = undist_cropped[ymin:ymax, xmin:xmax]

                    color_code, color_name, turn_cmd = detect_arrow_color(roi)

                    marker_for_draw = marker.astype(np.float32)
                    ids_to_draw = ids[i:i + 1]
                    color_roi = (xmin, ymin, xmax, ymax)

                    last_x_angle_deg = x_angle_deg
                    last_distance_m = distance_m
                    last_marker_for_draw = marker_for_draw
                    last_ids = ids_to_draw
                    last_color_roi = color_roi

                    break

        else:
            last_x_angle_deg = None
            last_distance_m = None
            last_marker_for_draw = None
            last_ids = None
            last_color_roi = None

        # Hold last good color briefly to prevent flicker
        if color_code != -1:
            last_color_code = color_code
            last_color_name = color_name
            last_turn_cmd = turn_cmd
            last_color_seen_frames = COLOR_HOLD_FRAMES
        elif last_color_seen_frames > 0:
            color_code = last_color_code
            color_name = last_color_name
            turn_cmd = last_turn_cmd
            last_color_seen_frames -= 1
        else:
            last_color_code = -1
            last_color_name = "NONE"
            last_turn_cmd = 0
            last_color_seen_frames = 0
            color_code = -1
            color_name = "NONE"
            turn_cmd = 0

    # Draw saved marker box
    if marker_for_draw is not None and ids_to_draw is not None:
        cv2.aruco.drawDetectedMarkers(
            undist_cropped,
            [marker_for_draw],
            ids_to_draw,
            borderColor=(255, 0, 255)
        )

    # Draw color search ROI
    if color_roi is not None:
        xmin, ymin, xmax, ymax = color_roi
        cv2.rectangle(
            undist_cropped,
            (xmin, ymin),
            (xmax, ymax),
            (255, 0, 255),
            2
        )

    angle_text = "--.-"
    dist_text = "--.-"

    if x_angle_deg is not None:
        angle_text = f"{x_angle_deg:.1f}"

    if distance_m is not None:
        dist_text = f"{distance_m:.2f}"

    cv2.putText(
        undist_cropped,
        f"Angle: {angle_text}",
        (20, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (0, 255, 0),
        2
    )

    cv2.putText(
        undist_cropped,
        f"Dist: {dist_text}",
        (20, 80),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (255, 255, 0),
        2
    )

    cv2.putText(
        undist_cropped,
        f"Color: {color_name}",
        (20, 120),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (0, 255, 255),
        2
    )

    cv2.putText(
        undist_cropped,
        f"Turn Cmd: {turn_cmd}",
        (20, 160),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (255, 200, 0),
        2
    )

    # Packet format:
    # color_code, turn_cmd, distance, angle
    if distance_m is not None and x_angle_deg is not None:
        packet = f"{color_code},{turn_cmd},{distance_m:.3f},{x_angle_deg:.1f}\n"
    else:
        packet = f"{color_code},0,-1.000,-999.0\n"

    # Throttled I2C send to avoid lag
    current_time = time.time()

    if current_time - last_arduino_send_time >= ARDUINO_SEND_INTERVAL:
        send_packet_i2c(packet)
        print("Sent I2C:", packet.strip())
        last_sent_packet = packet
        last_arduino_send_time = current_time

    cv2.imshow("Vision", undist_cropped)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()

#if not HEADLESS:
    #cv2.destroyAllWindows()

