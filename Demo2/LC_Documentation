/*
-- Demo 2: Marker Search, Alignment, and Autonomous Navigation --

Program behavior:
 - The robot continuously searches for a visual marker using incremental turns.
 - Once detected, it aligns itself to a target angle range using feedback from a Raspberry Pi.
 - After alignment, the robot drives forward a fixed distance using encoder feedback.
 - The robot will stop early if the Pi-reported distance threshold is reached.
 - Finally, the robot performs a 90-degree turn based on detected marker color:
     - Red → turn right
     - Green → turn left

Hardware notes:
 - I2C communication is used to receive marker data from a Raspberry Pi.
     - GPIO 4 -> A4
     - GPIO 5 -> A5
     - GND -> GND
 - Encoder A channels are interrupt-driven for counting wheel motion.
 - Motor driver enable pin must be HIGH for motion.
 - Direction inversion flags may be required depending on wiring.
*/

// LIBRARIES
#include <Wire.h>
#include <Arduino.h>

// I2C SLAVE SETTINGS
// Defines Arduino as an I2C slave receiving data from Pi
#define SLAVE_ADDRESS 0x08
#define BUFFER_SIZE 32

// MOTOR PINS
// Motor driver control pins
int ENABLE_PIN = 4;

int L_MOTOR_SIGN = 8;
int L_MOTOR_PWM  = 10;

int R_MOTOR_SIGN = 7;
int R_MOTOR_PWM  = 9;

 
// ENCODER PINS
// A channels trigger interrupts, B channels unused here
int L_ENC_A = 2;
int R_ENC_A = 3;
int enc1PinB = 5;
int enc2PinB = 6;

 
// MOTOR PARAMETERS
// PWM values for different motion behaviors
int motor_pwm = 35;     // search turning
int align_pwm = 35;     // fine alignment
int turn90_pwm = 80;    // final turn
int forward_pwm = 80;   // forward driving

// Encoder counters
long left_count = 0;
long right_count = 0;

// Direction signs used during encoder counting
int left_dir_sign = -1;
int right_dir_sign = +1;

// Robot geometry
float wheel_radius_m = 0.0873125;
float wheel_base_m   = 0.15;
long counts_per_rev  = 3200;

// Turn calibration gain
float TURN_GAIN = 1.35;

// Motor direction inversion flags (for wiring correction)
bool L_DIR_INVERT = false;
bool R_DIR_INVERT = true;

 
// MARKER DATA (FROM PI)
// Updated via I2C interrupt
 bool marker_detected = false;
 float beacon_distance_m = 0.0;
 float beacon_angle_deg = 0.0;
 int marker_color = -1;   // 0 = red, 1 = green

 
// ALIGNMENT SETTINGS
// Acceptable angle range for alignment
float MIN_TARGET_ANGLE = 25.0;
float MAX_TARGET_ANGLE = 26.0;

// Step sizes for search vs alignment
int ALIGN_STEP_DEG = 1;
int SEARCH_STEP_DEG = 5;

 
// FORWARD SETTINGS
// Target travel distance (~4.5 ft)
float FORWARD_DISTANCE_M = 4.5 * 0.3048;

// Stop early if Pi reports close enough
float STOP_DISTANCE_FROM_PI_M = 1.8;

 
// MOTOR HELPER FUNCTIONS

// Sets motor direction and speed
void setMotor(int signPin, int pwmPin, int pwm, bool forward) {
  bool cmdForward = forward;

  // Apply inversion if needed
  if (signPin == L_MOTOR_SIGN && L_DIR_INVERT) cmdForward = !cmdForward;
  if (signPin == R_MOTOR_SIGN && R_DIR_INVERT) cmdForward = !cmdForward;

  digitalWrite(signPin, cmdForward ? HIGH : LOW);
  analogWrite(pwmPin, constrain(pwm, 0, 255));
}

// Stops both motors immediately
void stopMotors() {
  analogWrite(L_MOTOR_PWM, 0);
  analogWrite(R_MOTOR_PWM, 0);
}

 
// ENCODER INTERRUPTS
// Increment counts based on motion direction

void encoder1ISR() {
  left_count += left_dir_sign;
}

void encoder2ISR() {
  right_count += right_dir_sign;
}

 
// I2C RECEIVE EVENT
// Expected format:
// color,turn_cmd,distance,angle
void receiveEvent(int howMany) {
  String line = "";

  while (Wire.available()) {
    line += (char)Wire.read();
  }

  if (line.length() == 0) return;

  // Parse comma-separated values
  int firstComma  = line.indexOf(',');
  int secondComma = line.indexOf(',', firstComma + 1);
  int thirdComma  = line.indexOf(',', secondComma + 1);

  if (firstComma > 0 && secondComma > 0 && thirdComma > 0) {

    String colorStr    = line.substring(0, firstComma);
    String distanceStr = line.substring(secondComma + 1, thirdComma);
    String angleStr    = line.substring(thirdComma + 1);

    marker_color = colorStr.toInt();

    float distance = distanceStr.toFloat();
    float angle    = angleStr.toFloat();

    beacon_distance_m = distance;
    beacon_angle_deg  = angle;

    // Debug output
    Serial.print("Parsed color: ");
    Serial.print(marker_color);
    Serial.print(" | Distance: ");
    Serial.print(beacon_distance_m, 3);
    Serial.print(" m | Angle: ");
    Serial.println(beacon_angle_deg, 2);

    // Validate marker data
    if (distance > 0.0 && angle > -180.0 && angle < 180.0) {
      marker_detected = true;
    } else {
      marker_detected = false;
      marker_color = -1;
    }
  }
}

 
// TURN FUNCTION
// Rotates robot using encoder feedback

void turnDegrees(char dir, int deg, int pwmSpeed, bool stopOnMarker = false) {

  deg = constrain(deg, -360, 360);

  // Handle negative angles
  if (deg < 0) {
    deg = abs(deg);
    dir = (dir == 'L') ? 'R' : 'L';
  }

  if (deg == 0) return;

  // Reset encoder counts
  noInterrupts();
  left_count = 0;
  right_count = 0;
  interrupts();

  // Compute required encoder counts
  float factor = (wheel_base_m / (2.0 * wheel_radius_m)) * ((float)deg / 360.0);
  long targetCounts = (long)(TURN_GAIN * factor * counts_per_rev);

  if (targetCounts < 5) targetCounts = 5;

  // Set motor directions
  if (toupper(dir) == 'L') {
    left_dir_sign  = +1;
    right_dir_sign = -1;
    setMotor(L_MOTOR_SIGN, L_MOTOR_PWM, pwmSpeed, true);
    setMotor(R_MOTOR_SIGN, R_MOTOR_PWM, pwmSpeed, false);
  } else {
    left_dir_sign  = -1;
    right_dir_sign = +1;
    setMotor(L_MOTOR_SIGN, L_MOTOR_PWM, pwmSpeed, false);
    setMotor(R_MOTOR_SIGN, R_MOTOR_PWM, pwmSpeed, true);
  }

  unsigned long start = millis();

  // Wait until target reached, marker seen, or timeout
  while (true) {
    if (stopOnMarker && marker_detected) break;

    long lc, rc;
    noInterrupts();
    lc = abs(left_count);
    rc = abs(right_count);
    interrupts();

    long avg = (lc + rc) / 2;

    if (avg >= targetCounts) break;
    if (millis() - start > 5000) break;
  }

  stopMotors();
  delay(100);
}

 
// SEARCH FOR MARKER
// Rotates in steps until marker is detected

void searchForMarker() {
  Serial.println("Starting search...");

  marker_detected = false;

  while (!marker_detected) {
    Serial.println("Searching...");
    turnDegrees('R', SEARCH_STEP_DEG, motor_pwm, true);
  }

  stopMotors();
  Serial.println("Marker detected.");
}

 
// ALIGNMENT FUNCTION
// Adjusts robot orientation until angle is within target range

bool alignToMarker() {
  Serial.println("Starting alignment...");

  while (true) {
    if (!marker_detected) {
      stopMotors();
      Serial.println("Marker lost.");
      return false;
    }

    float currentAngle = beacon_angle_deg;

    if (currentAngle >= MIN_TARGET_ANGLE && currentAngle <= MAX_TARGET_ANGLE) {
      stopMotors();
      Serial.println("Aligned successfully.");
      return true;
    }

    int step = 1;

    if (currentAngle < MIN_TARGET_ANGLE) {
      turnDegrees('L', step, align_pwm);
    } else {
      turnDegrees('R', step, align_pwm);
    }

    delay(120);
  }
}

 
// FINAL COLOR-BASED TURN

void finalTurnFromColor() {
  stopMotors();
  delay(300);

  if (marker_color == 0) {
    Serial.println("Red → RIGHT turn");
    turnDegrees('R', 90, turn90_pwm);
  } else if (marker_color == 1) {
    Serial.println("Green → LEFT turn");
    turnDegrees('L', 90, turn90_pwm);
  } else {
    Serial.println("Unknown color.");
  }

  stopMotors();
}

 
// SETUP

void setup() {
  // Configure motor pins
  pinMode(L_MOTOR_PWM, OUTPUT);
  pinMode(L_MOTOR_SIGN, OUTPUT);
  pinMode(R_MOTOR_PWM, OUTPUT);
  pinMode(R_MOTOR_SIGN, OUTPUT);
  pinMode(ENABLE_PIN, OUTPUT);
  digitalWrite(ENABLE_PIN, HIGH);

  // Configure encoder pins
  pinMode(L_ENC_A, INPUT_PULLUP);
  pinMode(R_ENC_A, INPUT_PULLUP);

  attachInterrupt(digitalPinToInterrupt(L_ENC_A), encoder1ISR, CHANGE);
  attachInterrupt(digitalPinToInterrupt(R_ENC_A), encoder2ISR, CHANGE);

  // Initialize I2C communication
  Wire.begin(SLAVE_ADDRESS);
  Wire.onReceive(receiveEvent);

  Serial.begin(9600);
  Serial.println("Robot ready.");
}

 
// MAIN LOOP

void loop() {

  searchForMarker();

  if (!alignToMarker()) return;

  moveForwardDistance(FORWARD_DISTANCE_M, forward_pwm);

  delay(500);

  finalTurnFromColor();

  stopMotors();

  Serial.println("Sequence complete.");

  while (1); // Stop execution
}
